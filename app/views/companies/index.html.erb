<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-1">Companies</h1>
      <p class="text-muted">Companies for <strong><%= current_organization&.name %></strong></p>
    </div>
    <div>
      <% if can?(:create, Company.new(organization_id: current_organization.id)) %>
        <%= link_to 'New Company', new_company_path, class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body">
      <%= search_form_for @q, url: companies_path, method: :get, class: 'row g-2 mb-3' do |f| %>
        <div class="col-auto">
          <%= f.label :name_cont, 'Name', class: 'form-label visually-hidden' %>
          <%= f.search_field :name_cont, placeholder: 'Search name', class: 'form-control' %>
        </div>
        <div class="col-auto">
          <%= f.submit 'Search', class: 'btn btn-outline-secondary' %>
        </div>
      <% end %>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4"><%= sort_link @q, :name, 'Company Name' %></th>
              <th scope="col" class="py-3">Industry</th>
              <th scope="col" class="py-3 text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @companies.each do |company| %>
              <tr>
                <td class="ps-4 fw-semibold"><%= link_to company.name, company_path(company), class: 'text-dark text-decoration-none' %></td>
                <td><%= company.industry %></td>
                <td class="pe-4 text-end">
                  <%= link_to 'View', company_path(company), class: 'btn btn-sm btn-outline-primary me-2' %>
                  <% if can?(:update, company) %>
                    <%= link_to 'Edit', edit_company_path(company), class: 'btn btn-sm btn-outline-secondary me-2' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-3">
        <%= paginate @companies %>
      </div>
    </div>
  </div>
</div>
