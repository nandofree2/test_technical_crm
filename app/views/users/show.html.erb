<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-4 position-relative">
          <div class="d-flex align-items-center">
            <div class="ms-4">
              <h2 class="fw-bold mb-1"><%= @user.name %></h2>
            </div>
          </div>
        </div>
        <div class="card-body p-4">
          <h5 class="fw-bold text-dark mb-4">Personal Information</h5>
          
          <div class="row g-3">
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <div class="text-muted small mb-1">Full Name</div>
                <div class="fw-semibold fs-5"><%= @user.name %></div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3">
                <div class="text-muted small mb-1">Email Address</div>
                <div class="fw-semibold fs-5"><%= @user.email %></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
            My Organizations
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-4">Organization Name</th>
                  <th scope="col">Slug</th>
                  <th scope="col">Role</th>
                  <th scope="col">Member Status</th>
                </tr>
              </thead>
              <tbody>
                <% if @memberships.any? %>
                  <% @memberships.each do |membership| %>
                    <tr>
                      <td class="ps-4">
                        <div class="d-flex align-items-center">
                          <%= link_to organization_path(membership.organization), class: "btn btn-sm btn-outline-primary px-3 fw-semibold" do %>
                            <span class="fw-bold"><%= membership.organization.name %></span>
                          <% end %>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= membership.organization.slug %></span>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= membership.role %></span>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= membership.member_status %></span>
                        <% if current_user.memberships.exists?(id: membership.id) && membership.member_status == 'inactive' %>
                          <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#switchOrgModal-<%= membership.id %>">
                            Switch
                          </button>

                          <div class="modal fade" id="switchOrgModal-<%= membership.id %>" tabindex="-1" aria-labelledby="switchOrgLabel-<%= membership.id %>" aria-hidden="true">
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5 class="modal-title" id="switchOrgLabel-<%= membership.id %>">Switch Organization</h5>
                                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                  Are you sure you want to switch to <strong><%= membership.organization.name %></strong>?
                                </div>
                                <div class="modal-footer">
                                  <%= button_to switch_organization_user_path(@user), method: :post, params: { membership_id: membership.id }, class: "btn btn-primary" do %>
                                    Confirm
                                  <% end %>
                                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </td>
                      <td class="pe-4 text-end">
                        
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">You are not a member of any organization.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>