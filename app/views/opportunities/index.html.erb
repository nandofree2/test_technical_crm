<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-1">Opportunities</h1>
      <p class="text-muted">Opportunity for <strong><%= current_organization&.name %></strong></p>
    </div>
    <div>
      <% if can?(:create, Opportunity.new(organization_id: current_organization.id)) %>
        <%= link_to 'New Opportunity', new_opportunity_path, class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body">
      <div class="row mb-4">
      <% ['lead', 'proposal', 'won', 'lost'].each do |stage_name| %>
          <% data = @summary[stage_name] || { count: 0, total: 0 } %>
          <div class="col-md-3">
            <div class="card border-0 shadow-sm">
              <div class="card-body text-center">
                <span class="badge bg-secondary text-uppercase mb-2"><%= stage_name %></span>
                <h4 class="fw-bold mb-1"><%= data[:count] %> <small class="fs-6 text-muted">items</small></h4>
                <p class="text-success fw-semibold mb-0">
                  <%= number_to_currency(data[:total], unit: "Rp ", precision: 0) %>
                </p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <%= search_form_for @q, url: opportunities_path, method: :get, class: "row g-3 mb-4" do |f| %>
      <div class="col-md-4">
        <%= f.label :title_cont, "Search Title", class: "form-label" %>
        <%= f.search_field :title_cont, class: "form-control", placeholder: "Filter by title..." %>
      </div>

      <div class="col-md-4">
        <%= f.label :stage_eq, "Filter by Stage", class: "form-label" %>
        <%= f.select :stage_eq, 
                    Opportunity.stages.map { |k, v| [k.titleize, v] }, 
                    { include_blank: "All Stages" }, 
                    { class: "form-select" } %>
      </div>

      <div class="col-md-4 d-flex align-items-end">
        <%= f.submit "Filter", class: "btn btn-primary me-2" %>
        <%= link_to "Reset", opportunities_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
    

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
            <th scope="col" class="py-3">Company Name</th>
              <th scope="col" class="py-3 ps-4"><%= sort_link @q, :title, 'Title' %></th>
              <th scope="col" class="py-3">Estimated Value</th>
              <th scope="col" class="py-3">stage</th>
              <th scope="col" class="py-3">Assigned To</th>
              <th scope="col" class="py-3 text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @opportunities.each do |opportunity| %>
              <tr>
              <td><%= opportunity.company.name %></td>
                <td class="ps-4 fw-semibold"><%= link_to opportunity.title, opportunity_path(opportunity), class: 'text-dark text-decoration-none' %></td>
                <td><%= number_to_currency(opportunity.estimated_value, unit: "Rp ", precision: 0) %></td>
                <td><span class="badge bg-primary"><%= opportunity.stage %></span></td>
                <td>
                  <% if opportunity.users.any? %>
                    <% opportunity.users.each do |user| %>
                      <span class="badge bg-primary"><%= user.name %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="pe-4 text-end">
                  <%= link_to 'View', opportunity_path(opportunity), class: 'btn btn-sm btn-outline-primary me-2' %>
                  <% if can?(:update, opportunity) %>
                    <%= link_to 'Edit', edit_opportunity_path(opportunity), class: 'btn btn-sm btn-outline-secondary me-2' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-3">
        <%= paginate @opportunities %>
      </div>
    </div>
  </div>
</div>
